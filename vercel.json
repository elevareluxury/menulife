{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "images": {
    "sizes": [128, 256, 384, 640, 750, 828, 1080, 1200, 1920],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "fcuiolmzfnhxyukkyeht.supabase.co",
        "pathname": "^/storage/v1/object/public/profile-media/.*$"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/cal/:file",
      "destination": "/api/calendar?f=:file"
    },
    {
      "source": "/:slug([a-zA-Z0-9][a-zA-Z0-9_-]*)/projects/:project([a-z0-9][a-z0-9-]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot|redditbot|Embedly|iframely|vkShare).*"
        }
      ],
      "destination": "/api/og?slug=:slug&project=:project"
    },
    {
      "source": "/:slug([a-zA-Z0-9][a-zA-Z0-9_-]*)/:space([a-zA-Z0-9][a-zA-Z0-9-]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot|redditbot|Embedly|iframely|vkShare).*"
        }
      ],
      "destination": "/api/og?slug=:slug&space=:space"
    },
    {
      "source": "/:slug([a-zA-Z0-9][a-zA-Z0-9_-]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Googlebot|bingbot|Applebot|redditbot|Embedly|iframely|vkShare).*"
        }
      ],
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-RDUKsJ8+kdRYJYIr7vu/UUhANOk+jS2hxSQ7o4CDeCE=' 'sha256-HYxlm8ui9rUIl64CfIVmMJWL6GVAPywYlEuzPuaHb3Q=' 'sha256-BcsdrbT/o8jEi+pjwx6RXWb+SS0HNXciSM4CM93I47Y=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; manifest-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://open.spotify.com https://w.soundcloud.com https://www.tiktok.com https://challenges.cloudflare.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
